<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="local.baget" value="http://localhost:8088/repository/nuget-hosted/index.json" allowInsecureConnections="true" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="local.baget">
            <package pattern="BusinessFramework.*" />
            <package pattern="EdgeServicesBuildingBlock.*" />
            <package pattern="feature-flag-provider" />
        </packageSource>
    </packageSourceMapping>
    <packageSourceCredentials>
        <local.baget>
            <add key="Username" value="admin" />
            <add key="ClearTextPassword" value="admin123" />
        </local.baget>
    </packageSourceCredentials>
</configuration>
