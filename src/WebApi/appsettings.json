{
  "AllowedHosts": "*",
  "RateLimits": {
    "Enabled": true,
    "KeyPrefix": "feature-flag"
  },
  "FixedWindowRateLimit": [
    {
      "path": "*",
      "limit": 120,
      "windowSeconds": 60
    },
    {
      "path": "evaluations/*",
      "limit": 600,
      "windowSeconds": 60
    }
  ],
  "SlidingWindowRateLimit": [
    {
      "path": "auth/login",
      "methods": [ "POST" ],
      "limit": 10,
      "windowSeconds": 60
    },
    {
      "path": "auth/refresh",
      "methods": [ "POST" ],
      "limit": 60,
      "windowSeconds": 60
    }
  ],
  "TokenBucketRateLimit": [
    {
      "path": "evaluations/*",
      "methods": [ "POST" ],
      "capacity": 100,
      "refillRate": 10
    }
  ],
  "ConcurrencyRateLimit": [
    {
      "path": "evaluations/*",
      "methods": [ "POST" ],
      "maxConcurrentRequests": 20
    }
  ],
  "RateLimitHistory": {
    "RetentionDays": 30,
    "BufferRetentionHours": 24,
    "MaxPendingEvents": 100000,
    "BatchSize": 1000
  },
  "BackgroundWork": {
    "TickSeconds": 1,
    "ScheduledPerTick": 20,
    "UsageBatchesPerTick": 200,
    "MaxPendingBatches": 100000,
    "CleanupRowsPerTick": 500,
    "QuarantineRetentionDays": 30,
    "TokenRetentionDays": 7,
    "DeduplicationRetentionDays": 7,
    "UsageRetentionDays": 90
  },
  "Security": {
    "TrustedProxies": [],
    "DataProtection": {
      "CertificatePath": "",
      "CertificatePassword": "",
      "PreviousCertificatePaths": []
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3005" ]
  }
}
